    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@cybershield/validator": "*",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "@cybershield/shared": "*"
  }
}
