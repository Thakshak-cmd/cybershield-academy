{
  "name": "@cybershield/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/app.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test \"test/!(integration).test.js\"",
