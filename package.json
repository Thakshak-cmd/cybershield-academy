{
  "name": "cybershield-academy",
  "private": true,
  "version": "0.1.0",
  "description": "A gamified platform for defensive web security education, with adaptive challenge sequencing via Bayesian Knowledge Tracing.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:atlas": "node scripts/dev.mjs --atlas",
    "seed": "node --env-file=.env.local apps/api/src/seed.js",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p jsconfig.json",
    "check": "node packages/validator/bin/check.js",
    "verify": "npm run typecheck && npm test --workspaces --if-present",
    "verify:all": "npm run verify && npm run test:integration --workspace @cybershield/api",
    "test:integration": "npm run test:integration --workspace @cybershield/api",
    "smoke": "npm run smoke --workspace @cybershield/api",
    "ml": "services/ml/.venv/bin/uvicorn app:app --port 8811 --app-dir services/ml --loop asyncio",
    "ml:test": "services/ml/.venv/bin/python -m pytest services/ml -q",
    "web": "npm run dev --workspace @cybershield/web",
    "dev:api": "npm run dev:memory --workspace @cybershield/api",
    "start": "node scripts/dev.mjs",
    "study:export": "node --env-file=.env.local scripts/study/export.mjs",
    "study:withdraw": "node --env-file=.env.local scripts/study/withdraw.mjs",
    "study:analyse": "node scripts/study/analyse.mjs",
    "study:rehearse": "node scripts/study/rehearse.mjs",
    "share": "node scripts/share.mjs"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "^5.7.2"
  }
}
