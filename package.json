{
  "name": "cybershield-academy",
  "private": true,
  "version": "0.1.0",
  "description": "A gamified platform for defensive web security education, with adaptive challenge sequencing via Bayesian Knowledge Tracing.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p jsconfig.json",
    "check": "node packages/validator/bin/check.js",
    "verify": "npm run typecheck && npm test --workspaces --if-present",
    "verify:all": "npm run verify && npm run test:integration --workspace @cybershield/api",
    "test:integration": "npm run test:integration --workspace @cybershield/api",
    "smoke": "npm run smoke --workspace @cybershield/api",
    "ml": "services/ml/.venv/bin/uvicorn app:app --port 8811 --app-dir services/ml --loop asyncio",
    "ml:test": "services/ml/.venv/bin/python -m pytest services/ml -q"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.5",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "^5.7.2"
  }
}
