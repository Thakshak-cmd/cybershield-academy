{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Progressive adoption: unannotated code stays `any` rather than erroring, so
    // adding JSDoc to a function is opt-in and never breaks the build for its
    // neighbours. What IS annotated gets checked strictly.
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "packages/*/src/**/*.js",
    "packages/*/test/**/*.js",
    "apps/*/src/**/*.js",
    "apps/*/test/**/*.js"
  ],
  "exclude": ["**/node_modules/**"]
}
