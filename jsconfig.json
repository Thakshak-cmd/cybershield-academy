{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Progressive adoption: unannotated code stays `any` rather than erroring, so
    // adding JSDoc to a function is opt-in and never breaks the build for its
    // neighbours. What IS annotated gets checked strictly.
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,

    // Without this, checkJs walks into dependencies' own JavaScript and reports
    // hundreds of errors in React's source, which is neither our code nor
    // actionable.
    "maxNodeModuleJsDepth": 0,

    "jsx": "react-jsx",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "packages/*/src/**/*.js",
    "packages/*/test/**/*.js",
    "packages/*/bin/**/*.js",
    "apps/*/src/**/*.js",
    "apps/*/src/**/*.jsx",
    "apps/*/test/**/*.js",
    "apps/*/scripts/**/*.js"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
