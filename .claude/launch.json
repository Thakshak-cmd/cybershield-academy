{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stack",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "stack-atlas",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:atlas"
      ],
      "port": 5173
