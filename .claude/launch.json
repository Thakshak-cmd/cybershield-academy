{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stack",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "stack-atlas",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:atlas"
      ],
      "port": 5173
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@cybershield/web"
      ],
      "port": 5173
    },
    {
      "name": "verify-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PORT=3101 node apps/api/scripts/dev-server.js & API_TARGET=http://localhost:3101 npm run dev --workspace @cybershield/web -- --port 5273 --strictPort"
      ],
      "port": 5273
    }
  ]
}
